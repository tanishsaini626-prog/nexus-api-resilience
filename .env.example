# --- Upstash Redis (circuit state, rate limits, routing mode) ---
# Upstash Redis REST API endpoint URL
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io

# Upstash Redis REST API access token
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# --- Supabase (auth + Postgres with row level security) ---
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe for the browser; RLS enforces who can read what)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Provider key encryption ---
# 32-byte key (64 hex chars) used to encrypt users' provider API keys at rest.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, keys are stored unencrypted (with a warning) so local setups still work.
# WARNING: rotating or losing this key makes existing encrypted rows unreadable —
# affected users must re-enter their provider keys.
NEXUS_ENCRYPTION_KEY=your-64-hex-character-key-here
